# =======================================================
# RealSolveAI - Variables de Entorno
# =======================================================
# Copia este archivo a .env y completa con tus valores reales
# IMPORTANTE: Nunca subas el archivo .env al repositorio

# =======================================================
# Base de Datos PostgreSQL
# =======================================================
# Formato: postgresql+psycopg2://usuario:contraseña@host:puerto/nombre_bd
# Para Docker: usar 'db' como host (nombre del servicio)
# Para desarrollo local: usar 'localhost'
DATABASE_URL=postgresql+psycopg2://postgres:12345@db:5432/realsolveai

# Variables de PostgreSQL (usadas por docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=realsolveai
POSTGRES_PORT=5432
DB_HOST=db

# =======================================================
# JWT y Seguridad
# =======================================================
# IMPORTANTE: Cambiar en producción por una clave segura
# Generar una clave segura: openssl rand -hex 32
JWT_SECRET=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_DAYS=30

# =======================================================
# OpenAI API
# =======================================================
# Obtener tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =======================================================
# Twilio
# =======================================================
# Obtener credenciales en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =======================================================
# Configuración de la Aplicación
# =======================================================
# Host público donde está desplegada la aplicación (para webhooks de Twilio)
# Ejemplo: https://api.tudominio.com o https://tu-ip-publica.com
# IMPORTANTE: Debe ser HTTPS en producción para que Twilio funcione correctamente
HOST=https://api.tudominio.com

# Temperatura del modelo de OpenAI (0.0 - 2.0)
# Valores más bajos = respuestas más deterministas
# Valores más altos = respuestas más creativas
TEMPERATURE=0.8

# =======================================================
# CORS (Cross-Origin Resource Sharing)
# =======================================================
# Orígenes permitidos separados por comas
# Ejemplo: http://localhost:3000,https://tudominio.com
# Dejar vacío para permitir todos (solo desarrollo)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =======================================================
# Notas de Producción
# =======================================================
# 1. Cambiar todas las contraseñas por defecto
# 2. Usar HTTPS en producción (HOST debe ser https://)
# 3. Configurar ALLOWED_ORIGINS con los dominios exactos de tu frontend
# 4. Generar JWT_SECRET seguro: openssl rand -hex 32
# 5. No exponer POSTGRES_PORT públicamente en producción
# 6. Usar docker-compose.prod.yml para producción
